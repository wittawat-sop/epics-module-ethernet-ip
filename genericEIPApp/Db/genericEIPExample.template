record(longin, "$(P)InputWord0") {
    field(DESC, "Generic T->O UINT16 at byte offset 0")
    field(DTYP, "Ethernet/IP")
    field(INP, "@etherip($(PORT),0)UINT16")
    field(SCAN, "I/O Intr")
    info(EIP_DIRECTION, "INPUT")
    info(EIP_OFFSET, "0")
    info(EIP_LENGTH, "2")
    info(EIP_DATATYPE, "UINT16")
}

record(bi, "$(P)InputBit0") {
    field(DESC, "Generic T->O bit 0 in byte offset 0")
    field(DTYP, "Ethernet/IP")
    field(INP, "@etherip($(PORT),0,0)BIT")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Off")
    field(ONAM, "On")
    info(EIP_DIRECTION, "INPUT")
    info(EIP_OFFSET, "0")
    info(EIP_LENGTH, "2")
    info(EIP_DATATYPE, "UINT16")
    info(EIP_BIT, "0")
}
