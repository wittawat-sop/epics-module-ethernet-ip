    field(ZRVL, "0")
    field(ZRST, "No setting")
    field(ONVL, "1")
    field(ONST, "Absolute positioning")
    field(TWVL, "2")
    field(TWST, "Inc command pos")
    field(THVL, "3")
    field(THST, "Inc feedback pos")
    field(FRVL, "7")
    field(FRST, "Cont position")
    field(FVVL, "8")
    field(FVST, "Wrap absolute positioning")
    field(SXVL, "9")
    field(SXST, "Wrap prox pos")
    field(SVVL, "10")
    field(SVST, "Wrap absolute FWD")
    field(EIVL, "11")
    field(EIST, "Wrap absolute RVS")
    field(NIVL, "12")
    field(NIST, "Wrap absolute push-motion")
    field(TEVL, "13")
    field(TEST, "Wrap prox push")
    field(TVVL, "14")
    field(TVST, "Wrap push-motion FWD")
    field(TTVL, "15")
    field(TTST, "Wrap push-motion RVS")
    field(FTVL, "16")
    field(FTST, "Continuous speed control")
    field(FFVL, "17")
    field(FFST, "Continuous push motion")
    info(ORIENTAL_EIP_ENUM_18, "18=Continuous torque control")
    info(ORIENTAL_EIP_ENUM_20, "20=Absolute push-motion")
    info(ORIENTAL_EIP_ENUM_21, "21=Incremental push-motion (command position)")
    info(ORIENTAL_EIP_ENUM_22, "22=Incremental push-motion (feedback position)")
}

