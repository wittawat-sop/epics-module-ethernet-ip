# Oriental Motor mapping implemented on the generic Ethernet/IP field layer.
# Link format: @etherip($(PORT),offset[,bit])TYPE

# -------------------------------------------------------------------
# Output Control Records (Instance 101 - Writes to Driver)
# -------------------------------------------------------------------
record(longout, "$(P)$(R)CmdFlags") {
    field(DESC, "Command Flags (Bitfield)")
    field(DTYP, "Ethernet/IP")
    field(OUT,  "@etherip($(PORT),0)UINT16")
    field(VAL,  "0")
}

